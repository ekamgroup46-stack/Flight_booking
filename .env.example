# Copy to `.env.local` and adjust. All variables are read in src/config/app.config.ts.

# Base URL of the booking backend (used once mocks are switched off).
VITE_API_BASE_URL=/api

# `true` = every service module answers from local mock data (current phase).
# `false` = service modules call the HTTP client against VITE_API_BASE_URL.
VITE_USE_MOCKS=true

# Simulated network latency for mock responses, in milliseconds (min,max).
VITE_MOCK_LATENCY=350,900

# Probability (0–1) that a mock request fails — handy for testing error states.
# You can also append ?simulate=error to any URL to force failures in the browser.
VITE_MOCK_FAILURE_RATE=0
